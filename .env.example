PORT=4000
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/soltech
# Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/soltech
MONGO_URI=mongodb://127.0.0.1:27017/soltech

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins ("*" for any)
CORS_ORIGIN=*
